# Copy to `.env` for local development, or set values in the Vibecode App ENV tab.
# Never commit real secrets. Variables prefixed with EXPO_PUBLIC_ are embedded in the app bundle.

# Recommended: deploy `server/ai-proxy` and point the app here so OpenAI keys stay server-side.
EXPO_PUBLIC_VIBECODE_AI_PROXY_URL=https://your-ai-proxy.example.com

# Provider API keys (rotate if previously committed). Prefer the proxy above for OpenAI in production.
EXPO_PUBLIC_VIBECODE_OPENAI_API_KEY=your_openai_api_key
EXPO_PUBLIC_VIBECODE_ANTHROPIC_API_KEY=your_anthropic_api_key
EXPO_PUBLIC_VIBECODE_GROK_API_KEY=your_xai_grok_api_key
EXPO_PUBLIC_VIBECODE_GOOGLE_API_KEY=your_google_api_key
EXPO_PUBLIC_VIBECODE_ELEVENLABS_API_KEY=your_elevenlabs_api_key

# RevenueCat public SDK keys (store-specific; still do not commit live keys)
EXPO_PUBLIC_VIBECODE_REVENUECAT_TEST_KEY=your_revenuecat_test_key
EXPO_PUBLIC_VIBECODE_REVENUECAT_APPLE_KEY=your_revenuecat_apple_key
EXPO_PUBLIC_VIBECODE_REVENUECAT_GOOGLE_KEY=your_revenuecat_google_key
